# Rewrite to www
Options +FollowSymLinks
RewriteEngine on

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect non-www to www (already using HTTPS from above rule)
RewriteCond %{HTTP_HOST} ^imranture.com [NC]
RewriteRule ^(.*)$ https://www.imranture.com/$1 [R=301,NC]

# 301 Redirect Entire Directory
RedirectMatch 301 imranture.com/page/E4-TimeStamper(.*) https://github.com/imranture/E4-TimeStamper/$1

# Clean URL for project pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^project/([a-zA-Z0-9_-]+)$ /project.html?id=$1 [L,QSA]
